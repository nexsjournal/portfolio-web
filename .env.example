BLOB_READ_WRITE_TOKEN=
STUDIO_PASSWORD=
STUDIO_USER=
STUDIO_SESSION_SECRET=

# 感谢相机 · AI 合影
# 显式选择：auto | cloudflare | ark | mock。默认 auto，按已填写的 key 自动选择。
POLAROID_PROVIDER=
POLAROID_RATE_LIMIT=4

# Cloudflare Workers AI：每天 10,000 Neurons 免费，FLUX.2 [klein] 支持多参考图。
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-9b

# 火山方舟 / 豆包 Seedream：新用户一次性免费额度，Seedream 4.0+ 支持多图和 4:3。
ARK_API_KEY=
ARK_IMAGE_MODEL=doubao-seedream-4-0-250828
ARK_IMAGE_SIZE=2048x1536
